<?xml version="1.0" encoding="UTF-8"?>
<!--
  Windows Task Scheduler example. Import with:
    schtasks /Create /TN "mail-rule-digest" /XML mail-rule-digest-task.xml
  Edit the paths first. Set WEBHOOK_URL (and any IMAP secrets) as user environment
  variables; do not store secrets in this file.
-->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Run mail-rule-digest once a day and post the digest to a webhook.</Description>
  </RegistrationInfo>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2025-01-01T07:30:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByDay>
        <DaysInterval>1</DaysInterval>
      </ScheduleByDay>
    </CalendarTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <StartWhenAvailable>true</StartWhenAvailable>
    <ExecutionTimeLimit>PT10M</ExecutionTimeLimit>
    <Enabled>true</Enabled>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>C:\Python312\python.exe</Command>
      <Arguments>-m mail_rule_digest --rules C:\mail-rule-digest\rules.toml --state C:\mail-rule-digest\state.json --webhook</Arguments>
      <WorkingDirectory>C:\mail-rule-digest</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
